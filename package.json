  "type": "module",
  "description": "CloudTAK plugin — Atmosphere-class weather: forecast, radar, alerts, lightning, fire/hydro/marine layers",
  "license": "AGPL-3.0-or-later",
  "main": "index.js",
  "scripts": {
    "lint": "eslint .",
    "check": "vue-tsc --noEmit",
    "verify": "bash verify-cloudtak.sh . livewx-radar",
    "build:bundle": "vite build --config vite.bundle.config.ts",
    "bundle": "npm run build:bundle && node scripts/bundle.mjs"
